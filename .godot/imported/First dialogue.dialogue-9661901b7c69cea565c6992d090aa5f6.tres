&"id": "11",
&"next_id": "12",
&"text": "ohhhhh, will see about that.",
&"type": "dialogue"
},
"12": {
&"character": "Evil pineapple",
&"id": "12",
&"next_id": "13",
&"text": "I will stole every yours money from yours bank account.",
&"type": "dialogue"
},
"13": {
&"character": "You",
&"id": "13",
&"next_id": "14",
&"text": "Go ahead, I only have 20.4 dollars in my bank account.",
