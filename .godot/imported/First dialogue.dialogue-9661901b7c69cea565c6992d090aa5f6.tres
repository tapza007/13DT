},
"14": {
&"character": "Evil pineapple",
&"id": "14",
&"next_id": "15",
&"text": "Wait what?",
&"type": "dialogue"
},
"15": {
&"character": "Evil pineapple",
&"id": "15",
&"next_id": "16",
&"text": "But I saw you having more than 100 games on yours computure.",
&"type": "dialogue"
},
"16": {
&"character": "You",
&"id": "16",
&"next_id": "17",
&"text": "Well that is the reason why I only have 20 bucks.",
&"type": "dialogue"
},
