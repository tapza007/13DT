&"character": "You",
&"id": "25",
&"next_id": "26",
&"text": "Wait why you were helping me now.",
&"type": "dialogue"
},
"26": {
&"character": "Evil pineapple",
&"id": "26",
&"next_id": "27",
&"text": "Because you were useless to me, since I could get yours money, so there is no point for staying in yours PC.",
&"type": "dialogue"
},
